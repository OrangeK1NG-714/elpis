# 生产环境配置示例
NODE_ENV=production
_ENV=prod

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USER=elpis
DB_PASSWORD=change_this_password
DB_DATABASE=elpis_db

# MySQL Root 密码
MYSQL_ROOT_PASSWORD=change_this_root_password

# JWT 配置
JWT_SECRET=change_this_jwt_secret_key
JWT_EXPIRES_IN=7d

# 服务器配置
PORT=7001
HOST=0.0.0.0

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# 其他配置
TZ=Asia/Shanghai
